{
 "doctype": "DocType",
 "name": "Tally Settings",
 "module": "Tally Connector",
 "issingle": 1,
 "is_submittable": 0,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "connection_section",
   "fieldtype": "Section Break",
   "label": "Tally Connection"
  },
  {
   "fieldname": "sync_enabled",
   "fieldtype": "Check",
   "label": "Sync Enabled",
   "default": "1",
   "description": "Off stops every export and import. Nothing is queued and nothing runs."
  },
  {
   "fieldname": "tally_host",
   "fieldtype": "Data",
   "label": "Tally Host",
   "default": "localhost",
   "reqd": 1,
   "description": "Hostname or IP where Tally Prime is running"
  },
  {
   "fieldname": "tally_port",
   "fieldtype": "Int",
   "label": "Tally XML Port",
   "default": 9000,
   "reqd": 1,
   "description": "Default Tally XML Server port is 9000"
  },
  {
   "fieldname": "erpnext_company",
   "fieldtype": "Link",
   "options": "Company",
   "label": "ERPNext Company",
   "description": "The company whose books go to the Tally company below. Scheduled sync uses this and nothing else."
  },
  {
   "fieldname": "company_name_in_tally",
   "fieldtype": "Data",
   "label": "Company Name in Tally",
   "reqd": 1,
   "description": "Must exactly match the company name in your Tally Prime data"
  },
  {
   "fieldname": "cb1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_sync_at",
   "fieldtype": "Datetime",
   "label": "Last Sync At",
   "read_only": 1
  },
  {
   "fieldname": "export_section",
   "fieldtype": "Section Break",
   "label": "Export Settings"
  },
  {
   "fieldname": "default_export_format",
   "fieldtype": "Select",
   "label": "Default Export Format",
   "options": "Tally XML\nJSON\nExcel",
   "default": "Tally XML"
  },
  {
   "fieldname": "import_duplicate_behaviour",
   "fieldtype": "Select",
   "label": "If a master already exists",
   "options": "Leave it alone\nReplace it\nCombine balances",
   "default": "Leave it alone",
   "description": "What Tally does when an imported ledger or item is already there."
  },
  {
   "fieldname": "voucher_import_action",
   "fieldtype": "Select",
   "label": "Voucher import mode",
   "options": "Create\nAlter",
   "default": "Create",
   "description": "Create adds vouchers. Alter updates ones Tally already has."
  },
  {
   "fieldname": "send_voucher_guid",
   "fieldtype": "Check",
   "default": "0",
   "label": "Send a GUID on each voucher",
   "description": "Off until proven against your Tally. A GUID lets TallyPrime's overwrite-on-same-GUID option recognise a re-import, but ours is not in Tally's own format and a live Tally crashed while importing vouchers carrying it."
  },
  {
   "fieldname": "send_voucher_inventory",
   "fieldtype": "Check",
   "label": "Send item detail on vouchers",
   "default": "1",
   "description": "On, an invoice carries its items, quantities and rates. Off, each item's value is folded onto the ledger it already posted to and the items are dropped: the accounting is identical and Tally's stock summary stays empty."
  },
  {
   "fieldname": "export_from_date",
   "fieldtype": "Date",
   "label": "Default Export From Date",
   "description": "Leave blank to export all records"
  },
  {
   "fieldname": "cb2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "include_sales_invoice",
   "fieldtype": "Check",
   "label": "Include Sales Invoices",
   "default": 1
  },
  {
   "fieldname": "include_purchase_invoice",
   "fieldtype": "Check",
   "label": "Include Purchase Invoices",
   "default": 1
  },
  {
   "fieldname": "include_payment_entry",
   "fieldtype": "Check",
   "label": "Include Payment Entries",
   "default": 1
  },
  {
   "fieldname": "include_journal_entry",
   "fieldtype": "Check",
   "label": "Include Journal Entries",
   "default": 1
  },
  {
   "fieldname": "include_bank_transaction",
   "fieldtype": "Check",
   "label": "Include Bank Transactions",
   "default": 1
  },
  {
   "fieldname": "include_chart_of_accounts",
   "fieldtype": "Check",
   "label": "Include Chart of Accounts",
   "default": 1
  },
  {
   "fieldname": "include_parties",
   "fieldtype": "Check",
   "label": "Include Customers & Suppliers",
   "default": 1
  },
  {
   "fieldname": "include_stock_items",
   "fieldtype": "Check",
   "label": "Include Stock Items",
   "default": 1
  },
  {
   "fieldname": "include_stock_groups",
   "fieldtype": "Check",
   "label": "Include Stock Groups",
   "default": 1,
   "description": "Send item groups to Tally as stock groups."
  },
  {
   "fieldname": "include_godowns",
   "fieldtype": "Check",
   "label": "Include Godowns",
   "default": 0,
   "description": "Send warehouses to Tally as godowns. Needs multiple godowns enabled there."
  },
  {
   "fieldname": "include_uoms",
   "fieldtype": "Check",
   "label": "Include Units of Measure",
   "default": 1
  },
  {
   "fieldname": "tally_section",
   "fieldtype": "Section Break",
   "label": "Tally Mapping"
  },
  {
   "fieldname": "sales_voucher_type",
   "fieldtype": "Data",
   "label": "Sales Voucher Type in Tally",
   "default": "Sales",
   "description": "Name of the Sales voucher type in Tally"
  },
  {
   "fieldname": "purchase_voucher_type",
   "fieldtype": "Data",
   "label": "Purchase Voucher Type in Tally",
   "default": "Purchase"
  },
  {
   "fieldname": "receipt_voucher_type",
   "fieldtype": "Data",
   "label": "Receipt Voucher Type in Tally",
   "default": "Receipt"
  },
  {
   "fieldname": "payment_voucher_type",
   "fieldtype": "Data",
   "label": "Payment Voucher Type in Tally",
   "default": "Payment"
  },
  {
   "fieldname": "journal_voucher_type",
   "fieldtype": "Data",
   "label": "Journal Voucher Type in Tally",
   "default": "Journal"
  },
  {
   "fieldname": "contra_voucher_type",
   "fieldtype": "Data",
   "label": "Contra Voucher Type",
   "default": "Contra",
   "description": "Tally voucher type for transfers between your own cash and bank accounts."
  },
  {
   "fieldname": "credit_note_voucher_type",
   "fieldtype": "Data",
   "label": "Credit Note Voucher Type",
   "default": "Credit Note",
   "description": "Tally voucher type for a sales return."
  },
  {
   "fieldname": "debit_note_voucher_type",
   "fieldtype": "Data",
   "label": "Debit Note Voucher Type",
   "default": "Debit Note",
   "description": "Tally voucher type for a purchase return."
  },
  {
   "fieldname": "sales_ledger",
   "fieldtype": "Data",
   "label": "Sales Ledger",
   "default": "Sales"
  },
  {
   "fieldname": "purchase_ledger",
   "fieldtype": "Data",
   "label": "Purchase Ledger",
   "default": "Purchase"
  },
  {
   "fieldname": "tds_deductible_ledger",
   "fieldtype": "Data",
   "label": "TDS Deductible Ledger",
   "default": "TDS-Deductible"
  },
  {
   "fieldname": "cb3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "sundry_debtors_ledger",
   "fieldtype": "Data",
   "label": "Sundry Debtors Ledger",
   "default": "Sundry Debtors"
  },
  {
   "fieldname": "sundry_creditors_ledger",
   "fieldtype": "Data",
   "label": "Sundry Creditors Ledger",
   "default": "Sundry Creditors"
  },
  {
   "fieldname": "employee_ledger_group",
   "fieldtype": "Data",
   "label": "Employee Ledger Group",
   "default": "Sundry Creditors",
   "description": "Tally group for employee ledgers."
  },
  {
   "fieldname": "suspense_ledger",
   "fieldtype": "Data",
   "label": "Suspense Ledger",
   "default": "Suspense Account",
   "description": "Ledger for the unreconciled side of a bank line."
  },
  {
   "fieldname": "gst_output_ledger",
   "fieldtype": "Data",
   "label": "GST Output Tax Ledger",
   "default": "Output GST"
  },
  {
   "fieldname": "gst_input_ledger",
   "fieldtype": "Data",
   "label": "GST Input Tax Ledger",
   "default": "Input GST"
  },
  {
   "fieldname": "sb1",
   "fieldtype": "Section Break",
   "label": "Automation & Sync"
  },
  {
   "fieldname": "enable_auto_sync",
   "fieldtype": "Check",
   "label": "Enable Auto Sync"
  },
  {
   "fieldname": "auto_sync_interval",
   "fieldtype": "Select",
   "label": "Auto Sync Interval",
   "options": "Hourly\nTwice a Day\nDaily",
   "default": "Daily",
   "depends_on": "eval:doc.enable_auto_sync == 1"
  },
  {
   "fieldname": "cb4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "bank_recon_master",
   "fieldtype": "Select",
   "label": "Bank Reconciliation Master",
   "options": "ERPNext\nTally",
   "default": "ERPNext",
   "description": "Choose which system acts as the master for Bank Reconciliation clearance dates."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1,
   "write": 1
  }
 ]
}
